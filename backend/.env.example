# Application
APP_NAME=AetherQore POS
ENVIRONMENT=development
DEBUG=false
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database — PostgreSQL for docker-compose; SQLite for a single Windows PC
# PostgreSQL: postgresql+psycopg2://aetherqore:aetherqore@localhost:5432/aetherqore
# SQLite file: sqlite:///./aetherqore.db
DATABASE_URL=postgresql+psycopg2://aetherqore:aetherqore@localhost:5432/aetherqore

# Local production data directory (Windows installer sets this automatically)
# DATA_DIR=
# HOST=127.0.0.1
# PORT=8000
# FRONTEND_URL=http://127.0.0.1:3000

# CORS — comma-separated frontend origins (localhost only for a single PC)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional AI. Leave blank for a fully offline pharmacy. The app starts without these.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
