# Copy is created by `python -m app init-config` into the data directory.
# Do not put real secrets in the source tree.

APP_NAME=AetherQore POS
ENVIRONMENT=production
DEBUG=false
SECRET_KEY=generate-with-init-config
ACCESS_TOKEN_EXPIRE_MINUTES=720
REFRESH_TOKEN_EXPIRE_DAYS=14
DATABASE_URL=sqlite-file-is-written-by-init-config
HOST=127.0.0.1
PORT=8000
FRONTEND_URL=http://127.0.0.1:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
BACKUP_KEEP=14

# Leave blank for offline pharmacies. The API starts without them.
AI_PROVIDER=
AI_API_KEY=
